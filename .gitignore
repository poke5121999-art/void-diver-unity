# Ripped game content is regenerated by tools/rip/regen.sh from the installed game; it never goes to git.
# The repo keeps only what it owns: our code (Assets/_VD), the game code we rewrite in place of the
# stubs (each keeps its GUID so prefabs bind), project settings and the package manifest.
/Assets/*
!/Assets/_VD/
!/Assets/_VD.meta
!/Assets/Scripts/
!/Assets/Scripts.meta
/Assets/Scripts/*
!/Assets/Scripts/De.*/
!/Assets/Scripts/De.*.meta
!/Assets/Scripts/Global/
!/Assets/Scripts/Global.meta
!/Assets/Scripts/NemoLib/
!/Assets/Scripts/NemoLib.meta
!/Assets/Scripts/NemoMapTools/
!/Assets/Scripts/NemoMapTools.meta
!/Assets/Scripts/Assembly-CSharp/
!/Assets/Scripts/Assembly-CSharp.meta
!/Assets/Scripts/Base.Art/
!/Assets/Scripts/Base.Art.meta
!/Assets/Scripts/LCArt/
!/Assets/Scripts/LCArt.meta
!/Assets/Scripts/LCArt.URP/
!/Assets/Scripts/LCArt.URP.meta
!/Assets/Scripts/SomeNet.Unity/
!/Assets/Scripts/SomeNet.Unity.meta
/Packages/com.esotericsoftware.*/
/captures/catalog.json
